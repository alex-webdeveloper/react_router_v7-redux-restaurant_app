{
  "name": "react_router_v7-redux-restaurant_app",
  "private": true,
  "type": "module",
  "homepage": "https://alex-webdeveloper.github.io/react_router_v7-redux-restaurant_app",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "postbuild": "cp build/client/index.html build/client/404.html",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build/client"
  },
  "dependencies": {
    "@react-router/node": "^7.3.0",
    "@react-router/serve": "^7.3.0",
    "@reduxjs/toolkit": "^2.6.1",
    "axios": "^1.8.3",
    "bootstrap": "^5.3.3",
    "isbot": "^5.1.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.3.0",
    "reactstrap": "^9.2.3"
  },
  "devDependencies": {
    "@react-router/dev": "^7.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^20",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/react-redux": "^7.1.34",
    "autoprefixer": "^10.4.21",
    "gh-pages": "^6.3.0",
    "react-router-devtools": "^1.1.0",
    "sass-embedded": "^1.86.0",
    "tailwindcss": "^4.0.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
